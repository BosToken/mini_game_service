generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id        String         @id @default(uuid())
  username  String?        @unique
  email     String?        @unique
  password  String?
  discordId String?        @unique
  cards     cardsOnUsers[]
  team      teams?
  userLimit userLimits?
}

model userLimits {
  id          String @id @default(uuid())
  userId      String @unique 
  user        users  @relation(fields: [userId], references: [id])
  gachaLimit  BigInt   @db.BigInt
  battleLimit BigInt   @db.BigInt
}

model cards {
  id          String         @id @default(uuid())
  characterId String
  users       cardsOnUsers[]
  cardDetail  cardDetails?
}

model cardsOnUsers {
  id     String @id @default(uuid())
  userId String 
  user   users  @relation(fields: [userId], references: [id])
  cardId String 
  card   cards  @relation(fields: [cardId], references: [id])
}

model teams {
  id     String  @id @default(uuid())
  userId String  @unique
  user   users   @relation(fields: [userId], references: [id])
  cardId String?
}

model cardDetails {
  id       String   @id @default(uuid())
  level    Int
  cardId   String   @unique 
  card     cards    @relation(fields: [cardId], references: [id])
  rarityId String  
  rarity   rarities @relation(fields: [rarityId], references: [id])
  roleId   String   
  role     roles    @relation(fields: [roleId], references: [id])
  atk      Int
  health   Int
}

model rarities {
  id          String        @id @default(uuid())
  name        String
  description String
  rate        Int
  minAtk      Int
  maxAtk      Int
  minHealth   Int
  maxHealth   Int
  cardDetails cardDetails[]
}

model roles {
  id          String        @id @default(uuid())
  name        String
  description String
  priority    Int
  cardDetails cardDetails[]
}
